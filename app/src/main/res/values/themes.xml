<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="ink">#FF0B0E13</color>
    <color name="amber">#FFFFB547</color>

    <!-- Plain platform theme: Compose draws everything. -->
    <style name="Theme.Mura" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Shown for the instant before Compose renders the animated splash -->
    <style name="Theme.Mura.Splash">
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>
</resources>
